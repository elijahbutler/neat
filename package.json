{
  "name": "neat",
  "version": "1.0.0",
  "description": "Neat Labs editor: change a running Next.js app and get a pull request in your own components",
  "type": "module",
  "bin": {
    "neat": "./bin/neat.ts"
  },
  "scripts": {
    "neat": "bun run ./bin/neat.ts",
    "cli": "bun run ./bin/neat.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "test:docker": "NEAT_DOCKER_TESTS=1 bun test src/sandbox",
    "fixtures:install": "bun scripts/fixtures-install.ts",
    "editor": "bun scripts/editor-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@babel/parser": "7.29.9",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "magic-string": "1.4.1",
    "next": "^16.3.5",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ts-morph": "28.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node-html-parser": "^9.0.4",
    "typescript": "^5.8.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elijahbutler/neat"
  }
}
